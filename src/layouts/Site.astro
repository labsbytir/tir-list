---
interface NavCat {
  id: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  categories?: NavCat[];
  activeCat?: string;
  filterNav?: boolean;
}

const { title, description, categories = [], activeCat = "all", filterNav = false } = Astro.props as Props;
const repo = "https://github.com/labsbytir/tir-list";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: dark;
        --black: #020202;
        --evergreen: #0d2818;
        --black-forest: #04471c;
        --sea-green: #058c42;
        --malachite: #16db65;
        --mist: #d7efe0;
        --muted: #8fb8a0;
      }
      * { box-sizing: border-box; }
      body {
        font-family: system-ui, sans-serif;
        margin: 0;
        background: linear-gradient(180deg, var(--evergreen), var(--black));
        color: var(--mist);
        min-height: 100vh;
      }
      a { color: var(--malachite); }
      .wrap { margin: 0 auto; max-width: 1120px; padding: 0 1rem; }
      header.site {
        position: sticky;
        top: 0;
        z-index: 50;
        border-bottom: 1px solid var(--black-forest);
        background: rgba(2, 2, 2, 0.85);
        backdrop-filter: blur(12px);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 3.5rem;
        gap: 1rem;
      }
      .brand { display: flex; align-items: center; gap: 0.6rem; font-weight: 700; color: var(--mist); text-decoration: none; }
      .brand img { height: 1.75rem; width: auto; display: block; }
      nav.main { display: flex; align-items: center; gap: 0.25rem; }
      nav.main button, nav.main a {
        background: none;
        border: 0;
        color: var(--muted);
        font-size: 0.875rem;
        padding: 0.4rem 0.75rem;
        border-radius: 0.375rem;
        cursor: pointer;
        text-decoration: none;
      }
      nav.main button:hover, nav.main a:hover { color: var(--mist); background: var(--black-forest); }
      nav.main button.active { color: var(--malachite); background: var(--black-forest); }
      .header-actions { display: flex; align-items: center; gap: 0.5rem; }
      .btn-submit {
        border: 1px solid var(--sea-green);
        border-radius: 0.5rem;
        padding: 0.4rem 0.8rem;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--mist);
        text-decoration: none;
      }
      .btn-submit:hover { border-color: var(--malachite); color: var(--malachite); }
      .btn-menu { display: none; background: none; border: 1px solid var(--black-forest); border-radius: 0.5rem; color: var(--mist); padding: 0.35rem 0.6rem; cursor: pointer; }
      .hero { padding: 2rem 0 1rem; }
      .hero h1 { font-family: ui-monospace, monospace; margin: 0 0 0.25rem; color: var(--malachite); }
      .hero p { margin: 0; color: var(--muted); }
      .crumbs { font-size: 0.75rem; color: var(--muted); margin-bottom: 1rem; }
      .crumbs a { color: var(--muted); }
      .controls { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 1.25rem 0; align-items: center; }
      .controls input {
        flex: 1;
        min-width: 200px;
        background: var(--black);
        color: var(--mist);
        border: 1px solid var(--sea-green);
        border-radius: 0.5rem;
        padding: 0.55rem 0.8rem;
        font-size: 0.875rem;
      }
      .controls select,
      .controls input[type="number"] {
        flex: none;
        background: var(--black);
        color: var(--mist);
        border: 1px solid var(--sea-green);
        border-radius: 0.5rem;
        padding: 0.55rem 0.6rem;
        font-size: 0.8rem;
      }
      .controls input[type="number"] {
        width: 5.5rem;
      }
      .pills { display: flex; gap: 0.25rem; flex-wrap: wrap; }
      .pills button {
        background: none;
        border: 1px solid transparent;
        color: var(--muted);
        border-radius: 0.5rem;
        padding: 0.5rem 0.7rem;
        font-size: 0.8rem;
        cursor: pointer;
        white-space: nowrap;
      }
      .pills button:hover { color: var(--mist); }
      .pills button.active { color: var(--malachite); background: var(--black-forest); border-color: var(--sea-green); }
      .layout { display: grid; grid-template-columns: 1fr 320px; gap: 2rem; align-items: start; }
      section.block { margin-bottom: 2rem; }
      section.block h2 { font-size: 1rem; margin: 0 0 1rem; }
      .grid { display: flex; flex-direction: column; gap: 0.75rem; }
      .card {
        background: var(--evergreen);
        border: 1px solid var(--sea-green);
        border-radius: 0.75rem;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        transition: border-color 0.15s;
      }
      .card:hover { border-color: var(--malachite); }
      .card-title { font-family: ui-monospace, monospace; font-size: 0.9rem; margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .card-title a { color: var(--mist); text-decoration: none; }
      .card-title a:hover { color: var(--malachite); }
      .card-tags { font-size: 0.75rem; color: var(--malachite); margin: 0.25rem 0 0; }
      .card-links { display: inline-flex; gap: 0.5rem; }
      .card-desc {
        font-size: 0.875rem;
        color: var(--muted);
        line-height: 1.5;
        flex: 1;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .card-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 0.75rem;
        padding-top: 0.5rem;
        border-top: 1px solid var(--black-forest);
        font-size: 0.75rem;
        color: var(--muted);
      }
      .side-card {
        border: 1px solid var(--sea-green);
        border-radius: 0.75rem;
        overflow: hidden;
        margin-bottom: 1rem;
        background: var(--black);
      }
      .side-card header { padding: 0.75rem 1rem; border-bottom: 1px solid var(--black-forest); font-size: 0.875rem; font-weight: 600; }
      .side-card .body { padding: 1rem; font-size: 0.875rem; }
      .side-card ol { margin: 0 0 1rem; padding-left: 1.25rem; color: var(--muted); }
      .side-card li { margin-bottom: 0.25rem; }
      pre.cmd, pre.code {
        background: var(--evergreen);
        border: 1px solid var(--black-forest);
        border-radius: 0.5rem;
        padding: 0.6rem;
        font-size: 0.7rem;
        font-family: ui-monospace, monospace;
        overflow-x: auto;
        margin: 0 0 0.5rem;
        white-space: pre-wrap;
        word-break: break-all;
      }
      pre.changelog { font-size: 0.75rem; max-height: 320px; overflow-y: auto; }
      .btn-copy {
        width: 100%;
        background: var(--sea-green);
        color: var(--black);
        border: 0;
        border-radius: 0.5rem;
        padding: 0.6rem;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        margin-bottom: 0.5rem;
      }
      .btn-copy:hover { background: var(--malachite); }
      .cat-row { display: flex; justify-content: space-between; align-items: center; width: 100%; background: none; border: 0; color: var(--mist); padding: 0.4rem 0; font-size: 0.875rem; cursor: pointer; }
      .cat-row:hover { color: var(--malachite); }
      .cat-row .count { color: var(--muted); font-size: 0.75rem; }
      .stat-row { display: flex; gap: 1rem; flex-wrap: wrap; margin: 1rem 0; font-size: 0.85rem; color: var(--muted); }
      .stat-row strong { color: var(--malachite); }
      .link-row { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 1rem 0; }
      .link-row a {
        border: 1px solid var(--sea-green);
        border-radius: 0.5rem;
        padding: 0.4rem 0.8rem;
        font-size: 0.8rem;
        text-decoration: none;
      }
      .link-row a:hover { border-color: var(--malachite); }
      .release { border: 1px solid var(--black-forest); border-radius: 0.5rem; padding: 0.75rem; margin-bottom: 0.5rem; background: var(--black); }
      .release h3 { margin: 0 0 0.25rem; font-size: 0.9rem; font-family: ui-monospace, monospace; }
      .release time { font-size: 0.75rem; color: var(--muted); }
      .release p { font-size: 0.85rem; color: var(--muted); margin: 0.5rem 0 0; white-space: pre-wrap; }
      footer.site { border-top: 1px solid var(--black-forest); padding: 1.5rem 0 2rem; color: var(--muted); font-size: 0.8rem; }
      @media (max-width: 1023px) {
        .layout { grid-template-columns: 1fr; }
      }
      @media (max-width: 767px) {
        nav.main { display: none; position: absolute; top: 3.5rem; left: 0; right: 0; background: var(--black); flex-direction: column; align-items: stretch; padding: 0.5rem; border-bottom: 1px solid var(--black-forest); }
        nav.main.open { display: flex; }
        .btn-menu { display: block; }
        .btn-submit { display: inline-block; padding: 0.4rem 0.7rem; font-size: 0.8rem; }
      }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap header-inner">
        <a class="brand" href="/"><img src="/brand/tirlist-white.svg" alt="tir-list" /></a>
        <nav class="main" id="nav" aria-label="Categories">
          {
            filterNav ? (
              <>
                <button data-cat-link="all" class={activeCat === "all" ? "active" : ""}>All</button>
                {categories.map((c) => (
                  <button data-cat-link={c.id} class={activeCat === c.id ? "active" : ""}>{c.label}</button>
                ))}
              </>
            ) : (
              <>
                <a href="/">All tools</a>
                {categories.map((c) => (
                  <a href={`/#${c.id}`}>{c.label}</a>
                ))}
              </>
            )
          }
        </nav>
        <div class="header-actions">
          <a class="btn-submit" href="/auth/login">Sign in</a>
          <a class="btn-submit" href={`${repo}/fork`}>Submit a tool</a>
          <button class="btn-menu" id="menuBtn" aria-label="Open menu">☰</button>
        </div>
      </div>
    </header>

    <div class="wrap">
      <slot />
    </div>

    <footer class="site">
      <div class="wrap">
        tir-list — a catalog of modern web tools. <a href={repo}>GitHub</a> ·{' '}
        <a href="/leaderboard">Leaderboard</a> · <a href="/trending">Trending</a> ·{' '}
        <a href="/fresh">Fresh</a> · <a href="/compare">Compare</a> · <a href="/submit">Submit</a> ·{' '}
        <a href={`${repo}/blob/main/CONTRIBUTING.md`}>Contribute</a>
      </div>
    </footer>

    <script>
      document.addEventListener("click", (e) => {
        const copy = e.target.closest("[data-copy]");
        if (copy) {
          const done = () => {
            copy.textContent = "Copied ✓";
            setTimeout(() => {
              copy.textContent = copy.dataset.copyLabel || "Copy";
            }, 1500);
          };
          if (!copy.dataset.copyLabel) copy.dataset.copyLabel = copy.textContent;
          const text = copy.dataset.copy;
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(done, () => fallbackCopy(text, done));
          } else {
            fallbackCopy(text, done);
          }
        }
        if (e.target.closest("#menuBtn")) {
          document.getElementById("nav").classList.toggle("open");
        }
      });

      function fallbackCopy(text, done) {
        const ta = document.createElement("textarea");
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand("copy");
          done();
        } catch {
          /* clipboard unavailable */
        }
        ta.remove();
      }
    </script>
  </body>
</html>
