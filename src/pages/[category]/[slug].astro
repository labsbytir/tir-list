---
import Site from "../../layouts/Site.astro";
import ActivityHeatmap from "../../components/ActivityHeatmap.astro";
import Discussion from "../../components/Comments.tsx";
import Listing from "../../components/Listing.tsx";
import { StarsHistory, UsageHistory, ViewsHistory } from "../../components/RepoCharts.tsx";
import { categories, labels } from "../../lib/catalog";

export const prerender = true;

export async function getStaticPaths() {
  return categories.flatMap((c) =>
    c.items.map((entry) => ({
      params: { category: c.id, slug: entry.slug },
      props: { entry, category: c.id },
    }))
  );
}

const { entry, category } = Astro.props as { entry: any; category: string };
const label = labels[category] || category;
const s = entry.stats || {};
const hasGraphs =
  (entry.statsHistory?.length || 0) > 1 ||
  (entry.views?.weeks?.length || 0) > 0 ||
  (entry.activity?.length || 0) > 0;

const shared = new Set((entry.tags || []).filter((t: string) => t !== category));
const similar = categories
  .flatMap((c) => c.items.map((i) => ({ item: i, category: c.id })))
  .filter(
    (s) =>
      s.item.slug !== entry.slug &&
      (s.category === category || s.item.tags?.some((t: string) => shared.has(t)))
  )
  .slice(0, 4)
  .map((s) => ({
    href: `/${s.category}/${s.item.slug}`,
    name: s.item.name,
    description: s.item.description,
    stars: s.item.stats?.stars as number | undefined,
  }));

const installs: { label: string; href?: string; copy?: string }[] = [];
if (category === "servers") {
  const remote = entry.links?.website && !/github\.com/.test(entry.links.website) ? entry.links.website : "";
  const config = remote ? { url: remote } : { command: "npx", args: ["-y", entry.slug] };
  installs.push({
    label: "Cursor",
    href: `cursor://anysphere.cursor-deeplink/mcp/install?name=${encodeURIComponent(entry.slug)}&config=${encodeURIComponent(btoa(JSON.stringify(config)))}`,
  });
  installs.push({
    label: "VS Code",
    href: `vscode:mcp/install?${encodeURIComponent(JSON.stringify({ name: entry.slug, ...config }))}`,
  });
  if (remote) {
    installs.push({
      label: "Claude",
      href: `https://claude.ai/customize/connectors?modal=add-custom-connector&connectorName=${encodeURIComponent(entry.name)}&connectorUrl=${encodeURIComponent(remote)}`,
    });
  }
} else if (category === "skills" && entry.repo) {
  installs.push({ label: "Any agent", copy: `npx skills add ${entry.repo}` });
}
---

<Site
  title={`${entry.name} — tir-list ${label}`}
  description={`${entry.name}: ${entry.description}`}
  categories={Object.entries(labels).map(([id, label]) => ({ id, label }))}
>
  <p class="crumbs"><a href="/">Catalog</a> / {label} / {entry.slug}</p>
  <Listing
    client:load
    name={entry.name}
    owner={entry.repo?.split("/")[0]}
    description={entry.description}
    about={entry.about}
    url={entry.url}
    github={entry.links?.github}
    stars={s.stars}
    license={s.license}
    pushedAt={s.pushedAt}
    features={entry.features || []}
    highlights={entry.highlights || []}
    strengths={entry.verdict?.strengths || []}
    tradeoffs={entry.verdict?.tradeoffs || []}
    sampled={entry.verdict?.sampled}
    pricing={entry.pricing || []}
    pricingSource={entry.sources?.website}
    builtWith={entry.builtWith || []}
    similar={similar}
    installs={installs}
  />

  {entry.install ? (
    <div class="side-card" style="margin-bottom:1.5rem">
      <header>{entry.install.label}</header>
      <div class="body">
        <pre class="cmd">{entry.install.command}</pre>
        <button class="btn-copy" data-copy={entry.install.command}>Copy command</button>
      </div>
    </div>
  ) : null}

  <div class="layout">
    <div>
      {hasGraphs ? (
        <section class="block">
          <h2>Activity</h2>
          {(entry.statsHistory?.length || 0) > 1 ? (
            <>
              <h3 style="font-size:0.85rem;color:var(--muted)">Stars over time</h3>
              <StarsHistory client:load data={entry.statsHistory} />
            </>
          ) : null}
          {(entry.views?.weeks?.length || 0) > 0 ? (
            <>
              <h3 style="font-size:0.85rem;color:var(--muted)">Views per week</h3>
              <ViewsHistory client:load data={entry.views.weeks} />
            </>
          ) : null}
          {entry.activity?.length ? <ActivityHeatmap activity={entry.activity} /> : null}
        </section>
      ) : null}

      {entry.specs ? (
        <section class="block">
          <h2>Specs</h2>
          <div class="release">
            {entry.specs.modalities ? <p>Modalities: {entry.specs.modalities}</p> : null}
            {entry.specs.contextLength ? <p>Context: <strong>{Number(entry.specs.contextLength).toLocaleString()}</strong> tokens</p> : null}
            {entry.specs.maxOutput ? <p>Max output: <strong>{Number(entry.specs.maxOutput).toLocaleString()}</strong> tokens</p> : null}
            {entry.specs.pricingPrompt ? <p>Pricing: <strong>${entry.specs.pricingPrompt}</strong> / prompt 1M · <strong>${entry.specs.pricingCompletion}</strong> / completion 1M</p> : null}
            {entry.specs.releasedAt ? <p>Released: {entry.specs.releasedAt}</p> : null}
            {entry.specs.knowledgeCutoff ? <p>Knowledge cutoff: {entry.specs.knowledgeCutoff}</p> : null}
            {entry.specs.moderated !== undefined && entry.specs.moderated !== null ? <p>Moderated: {entry.specs.moderated ? "yes" : "no"}</p> : null}
            {entry.specs.parameters?.length ? <p>Parameters: {entry.specs.parameters.join(", ")}</p> : null}
            {entry.specs.endpoints?.length ? <p>Endpoints: {entry.specs.endpoints.join(", ")}</p> : null}
            {entry.specs.reasoning ? <p>Reasoning: {entry.specs.reasoning.mandatory ? "always on" : "optional"}{entry.specs.reasoning.defaultEffort ? ` (default ${entry.specs.reasoning.defaultEffort})` : ""}{entry.specs.reasoning.efforts?.length ? ` — ${entry.specs.reasoning.efforts.join(", ")}` : ""}</p> : null}
          </div>
        </section>
      ) : null}

      {entry.specs ? (
      <section class="block">
        <h2>FAQ</h2>
        {entry.specs?.contextLength ? (
          <details class="release">
            <summary>What is the context length?</summary>
            <p>{Number(entry.specs.contextLength).toLocaleString()} tokens.</p>
          </details>
        ) : null}
        {entry.specs?.modalities ? (
          <details class="release">
            <summary>What inputs and outputs are supported?</summary>
            <p>{entry.specs.modalities}</p>
          </details>
        ) : null}
        {entry.specs?.releasedAt ? (
          <details class="release">
            <summary>When was it released?</summary>
            <p>{entry.specs.releasedAt}{entry.specs.knowledgeCutoff ? ` (knowledge cutoff ${entry.specs.knowledgeCutoff})` : ""}.</p>
          </details>
        ) : null}
      </section>
      ) : null}

      {(() => {
        const vendor = (entry.permaslug || "").split("/")[0];
        const siblings = vendor
          ? categories
              .flatMap((c) => c.items.map((i) => ({ item: i, category: c.id })))
              .filter((s) => s.item.permaslug && s.item.permaslug.startsWith(vendor + "/") && s.item.slug !== entry.slug)
              .slice(0, 4)
          : [];
        if (!siblings.length) return null;
        return (
          <section class="block">
            <h2>More from {vendor}</h2>
            <div class="grid">
              {siblings.map((s) => (
                <article class="card">
                  <h3 class="card-title"><a href={`/${s.category}/${s.item.slug}`}>{s.item.name}</a></h3>
                  <p class="card-desc">{s.item.description}</p>
                </article>
              ))}
            </div>
          </section>
        );
      })()}

      {entry.benchmarks?.artificial_analysis || entry.benchmarks?.design_arena?.length ? (
        <section class="block">
          <h2>Benchmarks</h2>
          {entry.benchmarks.artificial_analysis ? (
            <table style="width:100%;border-collapse:collapse;font-size:0.85rem;margin-bottom:1rem">
              {Object.entries(entry.benchmarks.artificial_analysis)
                .filter(([, v]) => typeof v === "number")
                .sort((a, b) => (b[1] as number) - (a[1] as number))
                .map(([k, v]) => (
                  <tr><th style="text-align:left;color:var(--muted);padding:0.3rem 0.5rem;border-bottom:1px solid var(--black-forest)">{k.replace(/_/g, " ")}</th><td style="text-align:right">{v}</td></tr>
                ))}
            </table>
          ) : null}
          {(entry.benchmarks.design_arena || []).slice(0, 8).map((d: any) => (
            <div class="release">
              <h3>{d.category} · ELO {d.elo} (#{d.rank})</h3>
              <p>Win rate {d.win_rate}% over {d.tournament_stats?.total ?? "?"} matches</p>
            </div>
          ))}
          <p style="font-size:0.75rem;color:var(--muted)">Source: OpenRouter (openrouter.ai/rankings). Artificial Analysis scores via artificialanalysis.ai — attribute on republish.</p>
        </section>
      ) : null}

      {(entry.usageHistory?.length || 0) > 1 ? (
        <section class="block">
          <h2>Usage</h2>
          <h3 style="font-size:0.85rem;color:var(--muted)">Tokens per week on OpenRouter</h3>
          <UsageHistory client:load data={entry.usageHistory.map((u: any) => ({ date: u.date, tokens: u.tokens }))} />
          <p style="font-size:0.75rem;color:var(--muted)">Source: OpenRouter (openrouter.ai/rankings), CC BY 4.0.</p>
        </section>
      ) : null}

      {entry.releases?.length ? (
        <section class="block">
          <h2>Releases</h2>
          {entry.releases.slice(0, 5).map((r) => (
            <div class="release">
              <h3><a href={r.url}>{r.name}</a></h3>
              {r.publishedAt ? <time>{r.publishedAt.slice(0, 10)}</time> : null}
              {r.notes ? <p>{r.notes.slice(0, 300)}</p> : null}
            </div>
          ))}
        </section>
      ) : null}

      {entry.changelog ? (
        <section class="block">
          <h2>Changelog</h2>
          <p style="font-size:0.8rem;color:var(--muted)">
            From <a href={entry.changelog.url}>{entry.changelog.source}</a>
          </p>
          <pre class="code changelog">{entry.changelog.excerpt}</pre>
        </section>
      ) : null}

      <section class="block">
        <h2>Discussion</h2>
        <Discussion client:visible page={`${category}/${entry.slug}`} />
      </section>
    </div>
    <aside>
      <div class="side-card">
        <header>Details</header>
        <div class="body">
          <p style="margin:0 0 0.5rem">Category: {label}</p>
          {entry.repo ? <p style="margin:0 0 0.5rem">Repo: <a href={`https://github.com/${entry.repo}`}>{entry.repo}</a></p> : null}
          {s.pushedAt ? <p style="margin:0 0 0.5rem;color:var(--muted)">Pushed: {s.pushedAt.slice(0, 10)}</p> : null}
          {s.fetchedAt ? <p style="margin:0;color:var(--muted)">Stats fetched: {s.fetchedAt.slice(0, 10)}</p> : null}
        </div>
      </div>
      <div class="side-card">
        <header>Contribute</header>
        <div class="body">
          <p style="margin:0;color:var(--muted);font-size:0.8rem">
            Stats refresh on each <code>npm run collect:enrich</code>. Entries are files under
            <code> catalog/{category}/{entry.slug}.json</code> — open a PR to edit.
          </p>
        </div>
      </div>
    </aside>
  </div>
</Site>
