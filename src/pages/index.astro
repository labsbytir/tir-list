---
import Site from "../layouts/Site.astro";
import CatalogGrid from "../components/CatalogGrid.astro";
import { categories } from "../lib/catalog";

export const prerender = true;

const all = categories.flatMap((c) => c.items.map((item) => ({ ...item, cat: c.id, label: c.label })));
const columns = [
  { title: "Today's top MCP servers", items: all.filter((i) => i.cat === "servers") },
  { title: "Most downloaded skills", items: all.filter((i) => i.cat === "skills") },
  { title: "Models", items: all.filter((i) => i.cat === "models") },
  { title: "Agents", items: all.filter((i) => i.cat === "agents") },
  { title: "Tools", items: all.filter((i) => i.cat === "tools") },
  { title: "Containers", items: all.filter((i) => i.cat === "containers") },
].filter((c) => c.items.length);
---

<Site
  title="tir-list — modern web tools catalog"
  description="tir-list — a catalog of modern web tools. Find Skills, Models, Containers, Servers, Agents and Tools."
  categories={categories}
  filterNav
>
  <section class="hero-search">
    <canvas id="drift" aria-hidden="true"></canvas>
    <div class="hero-copy">
      <h1>Where you go<br />for tools.</h1>
      <p>Find skills, models, containers, servers, agents and tools.</p>
      <form class="search-pill" action="#grid">
        <input id="q" type="search" placeholder="Search by name" autocomplete="off" aria-label="Search tools" />
        <button type="submit">Search</button>
      </form>
      <div class="hero-links">
        <a href="/leaderboard">Best tools</a>
        <a href="/trending">Trending</a>
      </div>
      <div class="marquee" id="marquee">
        <div>
          {all.concat(all).map((item) => (
            <a href={`/${item.cat}/${item.slug}`}>{item.name}</a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="columns" id="grid">
    {columns.map((col) => (
      <section>
        <h2>{col.title}</h2>
        <CatalogGrid categories={[{ id: col.items[0].cat, label: col.title, items: col.items }]} />
      </section>
    ))}
  </div>

  <script>
    const c = document.getElementById("drift");
    const ctx = c.getContext("2d");
    const seed = 20261118;
    let s = seed;
    const rnd = () => ((s = (s * 16807) % 2147483647) / 2147483647);
    const spores = Array.from({ length: 180 }, () => ({ x: rnd(), y: rnd(), a: rnd() * 6.28 }));
    function frame() {
      const r = c.getBoundingClientRect();
      c.width = r.width;
      c.height = r.height;
      ctx.fillStyle = "rgba(2,2,2,0.18)";
      ctx.fillRect(0, 0, c.width, c.height);
      ctx.fillStyle = "#16db65";
      for (const p of spores) {
        p.a += 0.01;
        p.x += Math.cos(p.a) * 0.0015;
        p.y += Math.sin(p.a) * 0.0015;
        if (p.x < 0 || p.x > 1 || p.y < 0 || p.y > 1) { p.x = rnd(); p.y = rnd(); }
        ctx.fillRect(p.x * c.width, p.y * c.height, 1.5, 1.5);
      }
      requestAnimationFrame(frame);
    }
    frame();

    const q = document.getElementById("q");
    q.addEventListener("input", () => {
      const term = q.value.toLowerCase();
      for (const card of document.querySelectorAll("#grid .card")) {
        card.style.display = card.dataset.name.includes(term) ? "" : "none";
      }
    });
  </script>
</Site>

<style is:global>
  .hero-search { position: relative; min-height: 70vh; display: grid; place-items: center; overflow: hidden; }
  #drift { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-copy { position: relative; text-align: center; width: 100%; max-width: 640px; padding: 0 1rem; box-sizing: border-box; }
  .hero-copy h1 { font-family: ui-monospace, monospace; font-size: clamp(1.8rem, 9vw, 4.5rem); line-height: 1.05; color: var(--mist); margin: 0 0 1rem; }
  .hero-copy p { color: var(--muted); margin: 0 0 1.5rem; }
  .search-pill { display: flex; background: var(--black); border: 1px solid var(--sea-green); border-radius: 999px; padding: 0.35rem; max-width: 100%; }
  .search-pill input { flex: 1; background: transparent; border: 0; color: var(--mist); padding: 0.7rem 1rem; font-size: 1rem; outline: none; }
  .search-pill button { background: var(--sea-green); color: var(--black); border: 0; border-radius: 999px; padding: 0.7rem 1.4rem; font-weight: 700; }
  .hero-links { display: flex; gap: 0.5rem; justify-content: center; margin-top: 1rem; }
  .hero-links a { border: 1px solid var(--black-forest); border-radius: 999px; padding: 0.4rem 0.9rem; color: var(--mist); text-decoration: none; font-size: 0.85rem; }
  .marquee { overflow: hidden; margin-top: 1.5rem; }
  .marquee div { display: flex; gap: 0.5rem; width: max-content; animation: slide 40s linear infinite; }
  .marquee a { border: 1px solid var(--sea-green); border-radius: 999px; padding: 0.3rem 0.7rem; color: var(--mist); text-decoration: none; font-size: 0.8rem; white-space: nowrap; }
  @keyframes slide { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .columns { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 2rem; }
  .columns h2 { font-size: 1rem; margin: 0 0 0.75rem; }
  @media (max-width: 900px) { .columns { grid-template-columns: 1fr; } }
</style>
