---
interface Props {
  url: string;
  name: string;
  size?: number;
}

const { url, name, size = 28 } = Astro.props as Props;

let host = "";
try {
  host = new URL(url).hostname;
} catch {
  host = "";
}

const brand = host.split(".")[0].toLowerCase();
const src = brand
  ? `https://cdn.jsdelivr.net/gh/rdimascio/icons@master/icons/${brand}.svg`
  : null;
---

{src ? (
  <img
    src={src}
    alt={name.charAt(0).toUpperCase()}
    width={size}
    height={size}
    loading="lazy"
    style={`width:${size}px;height:${size}px;object-fit:cover;border-radius:8px;flex:none`}
    onerror="this.replaceWith(Object.assign(document.createElement('span'),{textContent:this.alt,style:'width:22px;height:22px;border-radius:6px;display:inline-flex;align-items:center;justify-content:center;background:#058c42;color:#020202;font-weight:800'}))"
  />
) : (
  <span
    aria-hidden="true"
    style={`width:${size}px;height:${size}px;border-radius:8px;flex:none;display:inline-flex;align-items:center;justify-content:center;background:var(--sea-green);color:var(--black);font-weight:800`}
  >
    {name.charAt(0).toUpperCase()}
  </span>
)}
