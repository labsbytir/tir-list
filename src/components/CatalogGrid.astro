---
interface Entry {
  slug: string;
  name: string;
  description: string;
  url: string;
  tags: string[];
}

interface Category {
  id: string;
  label: string;
  items: Entry[];
}

const { categories } = Astro.props as { categories: Category[] };
---

{
  categories.flatMap((c) =>
    c.items.map((item) => (
      <article class="card" data-cat={c.id} data-key={`${c.id}:${item.slug}`}>
        <h3 class="card-title">
          <a href={item.url}>{item.name}</a>
        </h3>
        <p class="card-tags">{item.tags.map((t) => `#${t}`).join(" ")}</p>
        <p class="card-desc">{item.description}</p>
        <div class="card-meta">
          <span>{c.label}</span>
          <a href={item.url}>Visit →</a>
        </div>
      </article>
    )),
  )
}
