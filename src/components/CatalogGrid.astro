---
import EntryIcon from "./EntryIcon.astro";

interface Entry {
  slug: string;
  name: string;
  description: string;
  url: string;
  tags: string[];
  links?: Record<string, string>;
}

interface Category {
  id: string;
  label: string;
  items: Entry[];
}

const { categories } = Astro.props as { categories: Category[] };
---

{
  categories.flatMap((c) =>
    c.items.map((item) => (
      <article
        class="card"
        data-cat={c.id}
        data-key={`${c.id}:${item.slug}`}
        data-name={item.name.toLowerCase()}
        data-stars={item.stats?.stars ?? ""}
        data-updated={(item.stats?.pushedAt || item.stats?.fetchedAt || "") as string}
      >
        <h3 class="card-title">
          <a href={`/${c.id}/${item.slug}`} style="display:inline-flex;align-items:center;gap:0.5rem">
            <EntryIcon url={item.url} name={item.name} size={22} />{item.name}
          </a>
        </h3>
        <p class="card-tags">{item.tags.map((t) => `#${t}`).join(" ")}</p>
        <p class="card-desc">{item.description}</p>
        <div class="card-meta">
          <span>{c.label}{item.stats?.tokens ? ` · ${item.stats.tokens} tokens` : ""}</span>
          <span class="card-links">
            <a href={item.url}>Visit →</a>
            {item.links?.github && item.links.github !== item.url ? <a href={item.links.github}>GitHub</a> : null}
            {item.links?.docs ? <a href={item.links.docs}>Docs</a> : null}
          </span>
        </div>
      </article>
    )),
  )
}
