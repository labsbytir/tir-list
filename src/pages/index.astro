---
import skills from '../data/skills.json';
import mcpServers from '../data/mcp-servers.json';
import aiModels from '../data/ai-models.json';
import linuxFlavors from '../data/linux-flavors.json';

const categories = [
  { id: 'skills', label: 'Skills', items: skills },
  { id: 'mcp-servers', label: 'MCP Servers', items: mcpServers },
  { id: 'ai-models', label: 'AI Models', items: aiModels },
  { id: 'linux-flavors', label: 'Linux Flavors', items: linuxFlavors },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>tir-list — modern web tools catalog</title>
    <style>
      :root { color-scheme: light dark; }
      body { font-family: system-ui, sans-serif; margin: 0 auto; max-width: 960px; padding: 2rem 1rem; }
      header { margin-bottom: 1.5rem; }
      .controls { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem; }
      .grid { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
      .card { border: 1px solid currentColor; border-radius: 0.5rem; padding: 0.75rem; }
      .card h3 { margin: 0 0 0.25rem; font-size: 1rem; }
      .card p { margin: 0.25rem 0; }
      .tag { font-size: 0.75rem; opacity: 0.75; margin-right: 0.25rem; }
    </style>
  </head>
  <body>
    <header>
      <h1>tir-list</h1>
      <p>Catalog of modern web tools: Skills, MCP Servers, AI Models, Linux Flavors.</p>
    </header>
    <div class="controls">
      <input id="q" type="search" placeholder="Search tools…" autocomplete="off" />
      <div id="tabs">
        <button data-cat="all">All</button>
        {categories.map((c) => <button data-cat={c.id}>{c.label}</button>)}
      </div>
    </div>
    <main class="grid" id="grid">
      {categories.flatMap((c) =>
        c.items.map((item) => (
          <article class="card" data-cat={c.id} data-search={`${item.name} ${item.description} ${item.tags.join(' ')}`.toLowerCase()}>
            <h3><a href={item.url}>{item.name}</a></h3>
            <p>{item.description}</p>
            <p>{item.tags.map((t) => <span class="tag">#{t}</span>)}</p>
          </article>
        ))
      )}
    </main>
    <script>
      const q = document.getElementById('q');
      const tabs = document.getElementById('tabs');
      const grid = document.getElementById('grid');
      let cat = 'all';
      function apply() {
        const needle = (q.value || '').toLowerCase();
        for (const el of grid.children) {
          const okCat = cat === 'all' || el.dataset.cat === cat;
          const okQ = !needle || (el.dataset.search || '').includes(needle);
          el.style.display = okCat && okQ ? '' : 'none';
        }
      }
      q.addEventListener('input', apply);
      tabs.addEventListener('click', (e) => {
        const b = e.target.closest('button');
        if (!b) return;
        cat = b.dataset.cat;
        apply();
      });
    </script>
  </body>
</html>
