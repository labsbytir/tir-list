---
import Site from "../layouts/Site.astro";
import CatalogGrid from "../components/CatalogGrid.astro";
import CategoryChart from "../components/CategoryChart.tsx";
import { categories } from "../lib/catalog";

export const prerender = true;

const repo = "https://github.com/labsbytir/tir-list";
const cloneCmd = `git clone ${repo}.git`;
const forkCmd = "gh repo fork labsbytir/tir-list --clone";
---

<Site
  title="tir-list — modern web tools catalog"
  description="tir-list — a catalog of modern web tools. Find Skills, Models, Containers, Servers, Agents and Tools."
  categories={categories}
  filterNav
>
  <div class="hero">
    <p class="crumbs">Catalog / All tools</p>
    <h1>tir-list</h1>
    <p>A catalog of modern web tools. Find Skills, Models, Containers, Servers, Agents and Tools.</p>
  </div>

  <div class="controls">
    <input id="q" type="search" placeholder="Search tools…" autocomplete="off" aria-label="Search tools" />
    <div class="pills" id="tabs">
      <button data-cat-link="all" class="active">All</button>
      {categories.map((c) => <button data-cat-link={c.id}>{c.label}</button>)}
    </div>
  </div>

  <div class="layout">
    <div>
      <section class="block">
        <h2>Overview</h2>
        <CategoryChart
          client:load
          data={categories.map((c) => ({ label: c.label, count: c.items.length }))}
        />
      </section>
      <section class="block">
        <h2>Browse tools</h2>
        <div class="grid" id="grid">
          <CatalogGrid categories={categories} server:defer>
            <p slot="fallback">Loading catalog…</p>
          </CatalogGrid>
        </div>
      </section>
    </div>
    <aside>
      <div class="side-card">
        <header>Add your tool</header>
        <div class="body">
          <ol>
            <li>Fork the repo</li>
            <li>Add an entry to <code>catalog/&lt;category&gt;/&lt;slug&gt;.json</code></li>
            <li>Open a pull request</li>
          </ol>
          <pre class="cmd">{forkCmd}</pre>
          <button class="btn-copy" data-copy={forkCmd}>Copy fork command</button>
          <pre class="cmd">{cloneCmd}</pre>
          <button class="btn-copy" data-copy={cloneCmd}>Copy clone command</button>
          <p style="margin:0.5rem 0 0;font-size:0.75rem;color:var(--muted)">
            See <a href={`${repo}/blob/main/CONTRIBUTING.md`}>CONTRIBUTING</a> for the entry schema.
          </p>
        </div>
      </div>
      <div class="side-card">
        <header>Generative art</header>
        <div class="body">
          <p style="margin:0;color:var(--muted);font-size:0.8rem">
            <a href="/art.html">Verdant Drift</a> — seeded p5.js spores in brand
            greens. New seed every visit to the seed box.
          </p>
        </div>
      </div>
      <div class="side-card">
        <header>Categories</header>
        <div class="body">
          {categories.map((c) => (
            <button class="cat-row" data-cat-link={c.id}>
              <span>{c.label}</span>
              <span class="count">{c.items.length} tools</span>
            </button>
          ))}
        </div>
      </div>
    </aside>
  </div>

  <script>
    import { Document } from "flexsearch";

    const q = document.getElementById("q");
    const grid = document.getElementById("grid");
    const validCats = new Set(
      [...document.querySelectorAll("#tabs [data-cat-link]")].map((b) => b.dataset.catLink)
    );
    let cat = validCats.has(location.hash.slice(1)) ? location.hash.slice(1) : "all";
    let keyOf = new Map();
    let index = buildIndex();

    function buildIndex() {
      const idx = new Document({
        tokenize: "forward",
        document: { id: "id", index: "text" },
      });
      keyOf = new Map();
      let id = 0;
      for (const el of grid.children) {
        if (!el.dataset || !el.dataset.key) continue;
        id += 1;
        keyOf.set(el.dataset.key, id);
        idx.add({ id, text: el.textContent || "" });
      }
      return idx;
    }

    function syncActive() {
      for (const b of document.querySelectorAll("[data-cat-link]")) {
        b.classList.toggle("active", b.dataset.catLink === cat);
      }
    }

    function apply() {
      const needle = (q.value || "").trim();
      let hits = null;
      if (needle) {
        hits = new Set();
        const found = index.search(needle, { suggest: true });
        for (const group of found) {
          for (const id of group.result) hits.add(id);
        }
      }
      for (const el of grid.children) {
        const okCat = cat === "all" || el.dataset.cat === cat;
        const okQ = !hits || hits.has(keyOf.get(el.dataset.key));
        el.style.display = okCat && okQ ? "" : "none";
      }
    }

    // Re-index when the deferred server island swaps in its content.
    new MutationObserver(() => {
      index = buildIndex();
      apply();
    }).observe(grid, { childList: true });

    document.addEventListener("click", (e) => {
      const link = e.target.closest("[data-cat-link]");
      if (link) {
        cat = link.dataset.catLink;
        syncActive();
        apply();
        return;
      }
    });

    syncActive();
    apply();
    q.addEventListener("input", apply);
  </script>
</Site>
